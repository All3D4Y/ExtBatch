<UserControl x:Class="CmOxeProvisioner.Views.DialPlanTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Malgun Gothic, Segoe UI, sans-serif">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <FontFamily x:Key="DialPlanMonoFont">Consolas, Malgun Gothic, Segoe UI</FontFamily>
        <Style TargetType="TextBlock" x:Key="DialPlanCenteredTextStyle">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="-">
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock" x:Key="DialPlanBoldTextStyle" BasedOn="{StaticResource DialPlanCenteredTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="DialPlanNumericTextStyle" BasedOn="{StaticResource DialPlanCenteredTextStyle}">
            <Setter Property="FontFamily" Value="{StaticResource DialPlanMonoFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style TargetType="TextBox" x:Key="DialPlanCenteredEditTextStyle">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" x:Key="DialPlanMetaTextBox" BasedOn="{StaticResource ModernTextBox}">
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                    <Setter Property="Opacity" Value="0.88"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader" x:Key="DialPlanCenteredHeaderStyle" BasedOn="{StaticResource ModernDataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TableGridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,2"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridColumnHeader" x:Key="InlineGroupedHeaderStyle" BasedOn="{StaticResource DialPlanCenteredHeaderStyle}">
            <Setter Property="Padding" Value="6,8,6,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <Border VerticalAlignment="Top"
                                    Height="3"
                                    Background="{TemplateBinding Tag}"
                                    SnapsToDevicePixels="True"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow" x:Key="DialPlanCenteredRowStyle" BasedOn="{StaticResource ModernDataGridRow}">
            <Setter Property="MinHeight" Value="35"/>
        </Style>
        <Style TargetType="DataGridCell" x:Key="DialPlanCenteredCellStyle" BasedOn="{StaticResource ModernDataGridCell}">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="CellBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CellBd" Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="CellBd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="CellBd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid" x:Key="DialPlanCenteredGridStyle" BasedOn="{StaticResource ModernDataGrid}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource TableGridLineBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource TableGridLineBrush}"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource DialPlanCenteredHeaderStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource DialPlanCenteredRowStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource DialPlanCenteredCellStyle}"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="False"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
        <ContextMenu x:Key="ApCellContextMenu">
            <MenuItem Header="브라우저로 열기" Tag="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="MenuApOpen_Click"/>
            <MenuItem Header="AP 주소 입력 / 수정" Tag="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="MenuApEdit_Click"/>
            <MenuItem Header="AP 미사용으로 초기화" Tag="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="MenuApClear_Click"/>
        </ContextMenu>
        <DataTemplate x:Key="CenterInlineDetailTemplate">
            <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource ChipBgBrush}">
                <Border Background="{DynamicResource SurfaceBrush}"
                        TextElement.Foreground="{DynamicResource TextBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1,1,1,2"
                        CornerRadius="0,0,6,6"
                        Margin="4,2,12,8"
                        Padding="12,10">
                    <Grid x:Name="InlineDetailRoot"
                          CommandManager.CanExecute="InlineDetailRoot_CanExecute"
                          CommandManager.Executed="InlineDetailRoot_Executed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Actions Strip -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource ChipBgBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="4,0,0,0"
                                CornerRadius="4"
                                Padding="10,6"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                        <TextBlock Text="선택됨 · 상세" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{Binding DetailHeaderTitleText}"
                                               FontSize="13.5" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DetailHeaderMetaText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="10,1,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource OxeBtn}"
                                            Content="이 센터로 개통 →"
                                            Height="27" Padding="10,0" Margin="0,0,6,0"
                                            Tag="{Binding}"
                                            Click="BtnInlineOpenExtCti_Click"/>
                                    <Button Content="{Binding StatusMoveButtonText}"
                                            IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Height="27" Padding="10,0" Margin="0,0,6,0"
                                            Tag="{Binding}"
                                            Click="BtnInlineToggleStatus_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource WarnBtn}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsClosedStatus}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource OxeBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource OxeFgBrush}"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource DangerBtn}"
                                            IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Content="완전 삭제 (JSON+Config)"
                                            Height="27" Padding="10,0" Margin="0,0,6,0"
                                            Tag="{Binding}"
                                            Click="BtnInlineFullDelete_Click"/>
                                    <Button Style="{StaticResource PrimaryBtn}"
                                            Content="▴ 접기"
                                            Height="27" Padding="10,0"
                                            Tag="{Binding}"
                                            Click="BtnInlineToggle_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Center Metadata & Line Toolbar -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,6"
                                Margin="0,0,0,8">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkInlineMergeCells"
                                              Style="{StaticResource ModernCheckBox}"
                                              Content="동일 셀 병합"
                                              IsChecked="True"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"
                                              Loaded="ChkInlineMergeCells_Loaded"
                                              Checked="ChkInlineMergeCells_Changed"
                                              Unchecked="ChkInlineMergeCells_Changed"
                                              ToolTip="연속 행에서 값이 같은 셀을 세로로 합쳐서 표시합니다."/>
                                    <Button Style="{StaticResource BaseBtn}" Content="+ 라인 추가" Height="27" Padding="9,0" Margin="0,0,5,0"
                                            IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Tag="{Binding}" Click="BtnInlineAddLine_Click"/>
                                    <Button Style="{StaticResource BaseBtn}" Content="선택 라인 삭제" Height="27" Padding="9,0" Margin="0,0,6,0"
                                            IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Tag="{Binding}" Click="BtnInlineRemoveLine_Click"/>
                                    <Button Style="{StaticResource PrimaryBtn}" Content="변경 저장 (DB + Config 프리셋)" Height="27" Padding="12,0"
                                            IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Tag="{Binding}" Click="BtnInlineSaveCenter_Click"/>
                                </StackPanel>

                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="위치" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Style="{StaticResource DialPlanMetaTextBox}"
                                             IsReadOnly="{Binding IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Text="{Binding location, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="InlineHeaderTextBox_GotFocus" LostKeyboardFocus="InlineHeaderTextBox_LostFocus"
                                             Width="84" Height="26" Margin="0,0,8,0"/>

                                    <TextBlock Text="센터명" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Style="{StaticResource DialPlanMetaTextBox}"
                                             IsReadOnly="{Binding IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Text="{Binding project, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="InlineHeaderTextBox_GotFocus" LostKeyboardFocus="InlineHeaderTextBox_LostFocus"
                                             Width="130" Height="26" Margin="0,0,8,0"/>

                                    <TextBlock Text="상태" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox Style="{StaticResource ModernComboBox}"
                                              IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              DropDownOpened="InlineHeaderStatus_DropDownOpened"
                                              SelectionChanged="InlineHeaderStatus_SelectionChanged"
                                              Width="90" Height="26" Margin="0,0,8,0">
                                        <ComboBoxItem Content="운영 중" Tag="active"/>
                                        <ComboBoxItem Content="테스트용" Tag="test"/>
                                        <ComboBoxItem Content="업무 종료" Tag="closed"/>
                                    </ComboBox>

                                    <TextBlock Text="Config연동명" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Style="{StaticResource DialPlanMetaTextBox}"
                                             IsReadOnly="{Binding IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Text="{Binding cmCustomerName, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="InlineHeaderTextBox_GotFocus" LostKeyboardFocus="InlineHeaderTextBox_LostFocus"
                                             Width="115" Height="26" Margin="0,0,8,0"/>

                                    <TextBlock Text="AP URL" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Style="{StaticResource DialPlanMetaTextBox}"
                                             IsReadOnly="{Binding IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Text="{Binding apUrl, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="InlineHeaderTextBox_GotFocus" LostKeyboardFocus="InlineHeaderTextBox_LostFocus"
                                             Width="155" Height="26" Margin="0,0,4,0" ToolTip="연동할 AP 웹페이지 주소 (예: https://...)"/>
                                    <Button Style="{StaticResource OxeBtn}" Content="↗" Height="26" Width="26" Padding="0" Margin="0,0,8,0"
                                            IsEnabled="{Binding HasApUrl}" Tag="{Binding}" Click="BtnOpenApUrl_Click" ToolTip="AP 웹주소 브라우저로 열기"/>

                                    <CheckBox Style="{StaticResource ModernCheckBox}" Content="VQueue" IsChecked="{Binding useVQueue, Mode=TwoWay}"
                                              IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Click="InlineHeaderCheckBox_Click" VerticalAlignment="Center" Margin="0,0,8,0"
                                              ToolTip="실제 Config VQueue 폴더 생성/삭제는 내선·CTI → Config 경로 ▾ → 적용하기에서도 실행 가능합니다."/>
                                    <CheckBox Style="{StaticResource ModernCheckBox}" Content="IVR(PG)" IsChecked="{Binding useIvr, Mode=TwoWay}"
                                              IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Click="InlineHeaderCheckBox_Click" VerticalAlignment="Center" Margin="0,0,8,0"
                                              ToolTip="실제 Config Place Group 생성/삭제는 내선·CTI → Config 경로 ▾ → 적용하기에서도 실행 가능합니다."/>

                                    <TextBlock Text="메모" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox Style="{StaticResource DialPlanMetaTextBox}"
                                             IsReadOnly="{Binding IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Text="{Binding notes, UpdateSourceTrigger=PropertyChanged}"
                                             GotKeyboardFocus="InlineHeaderTextBox_GotFocus" LostKeyboardFocus="InlineHeaderTextBox_LostFocus"
                                             Width="135" Height="26"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>

                        <!-- 21-Column Inline Editable Dial-Plan Lines Grid (Columns Built Dynamically with Vertical Merge Support) -->
                        <DataGrid x:Name="InlineLinesGrid"
                                  Grid.Row="2"
                                  Style="{StaticResource ModernDataGrid}"
                                  ColumnHeaderStyle="{StaticResource DialPlanCenteredHeaderStyle}"
                                  Background="{DynamicResource SurfaceBrush}"
                                  Foreground="{DynamicResource TextBrush}"
                                  BorderBrush="{DynamicResource TableGridLineBrush}"
                                  ItemsSource="{Binding lines}"
                                  MinHeight="96"
                                  MaxHeight="280"
                                  FrozenColumnCount="2"
                                  CanUserReorderColumns="False"
                                  AlternationCount="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="{Binding IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  GridLinesVisibility="None"
                                  BorderThickness="1,1,0,0"
                                  Initialized="InlineLinesGrid_Initialized"
                                  Loaded="InlineLinesGrid_Loaded"
                                  BeginningEdit="DataGrid_BeginningEdit"
                                  CellEditEnding="InlineLinesGrid_CellEditEnding">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border x:Name="CellFrame"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0">
                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="CellFrame" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter TargetName="CellFrame" Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- SUB-HEADER BAR (3-Column: Title Left | View/Edit Mode Switcher Center | Undo/Redo/Save/Backup Right) -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title + Work Mode / Dirty Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Style="{StaticResource BlockTitleAccentStyle}"/>
                    <TextBlock Text="선번장 · 센터 관리" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <Border x:Name="BadgeWorkMode"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2"
                            Margin="9,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="TxtWorkModeBadge"
                                   Text="조회 모드 (잠금)"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Center: Prominent View / Edit Mode Switcher -->
                <Border x:Name="BorderModeSwitcher"
                        Grid.Column="1"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1.5"
                        CornerRadius="9"
                        Padding="3"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnModeView"
                                Content="조회 모드 (잠금)"
                                Click="BtnModeView_Click"
                                Style="{StaticResource SegmentedBtnStyle}"
                                FontSize="12.5"
                                Padding="18,5"/>
                        <Button x:Name="BtnModeEdit"
                                Content="편집 모드"
                                Click="BtnModeEdit_Click"
                                Style="{StaticResource SegmentedBtnStyle}"
                                FontSize="12.5"
                                Padding="18,5"
                                Margin="3,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Right: Undo / Redo / Revert / Save / Backup Restore -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel x:Name="PanelEditActions" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="BtnUndo"
                                Style="{StaticResource BaseBtn}"
                                Content="↶ 취소"
                                Height="28" Padding="9,0" Margin="0,0,4,0"
                                IsEnabled="False"
                                ToolTip="실행 취소 (Ctrl+Z)"
                                Click="BtnUndo_Click"/>
                        <Button x:Name="BtnRedo"
                                Style="{StaticResource BaseBtn}"
                                Content="↷ 재실행"
                                Height="28" Padding="9,0" Margin="0,0,6,0"
                                IsEnabled="False"
                                ToolTip="다시 실행 (Ctrl+Y)"
                                Click="BtnRedo_Click"/>
                        <Button x:Name="BtnRevertAll"
                                Style="{StaticResource WarnBtn}"
                                Content="변경사항 되돌리기"
                                Height="28" Padding="10,0" Margin="0,0,5,0"
                                IsEnabled="False"
                                ToolTip="마지막 저장 상태로 미저장 변경사항 모두 되돌리기"
                                Click="BtnRevertAll_Click"/>
                        <Button x:Name="BtnSaveAll"
                                Style="{StaticResource PrimaryBtn}"
                                Content="변경사항 저장"
                                Height="28" Padding="12,0" Margin="0,0,6,0"
                                IsEnabled="False"
                                ToolTip="모든 변경사항 저장 + 자동 백업 (Ctrl+S)"
                                Click="BtnSaveAll_Click"/>
                        <Button x:Name="BtnRestoreBackup"
                                Style="{StaticResource BaseBtn}"
                                Content="백업 복원"
                                Height="28" Padding="9,0"
                                ToolTip="저장 시 자동 생성된 백업 파일에서 복원"
                                Click="BtnRestoreBackup_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14,10,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Edit Mode & Unsaved Changes Status Banner -->
            <Border x:Name="BorderEditBanner"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="{DynamicResource ChipBgBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="11,6"
                    Margin="0,0,0,8">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="TxtEditBannerRight"
                               DockPanel.Dock="Right"
                               Text="Ctrl+Z 실행 취소 · Ctrl+Y 다시 실행 · Ctrl+S 저장"
                               FontSize="11.5"
                               Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                    <TextBlock x:Name="TxtEditBannerMain"
                               Text="편집 모드 활성화됨 — 표 셀 수정, 행 추가/삭제, AP 주소 변경 후 '변경사항 저장'을 누르세요."
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Row 1: Sub-Tabs + Global Actions -->
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <!-- Right: Global Actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnFindEmpty"
                            Style="{StaticResource BaseBtn}"
                            Content="빈 번호 찾기"
                            Height="30" Padding="11,0" Margin="0,0,6,0"
                            Click="BtnFindEmpty_Click"/>
                    <Button x:Name="BtnAddCenterPopup"
                            Style="{StaticResource PrimaryBtn}"
                            Content="+ 센터 추가"
                            Height="30" Padding="12,0" Margin="0,0,6,0"
                            Click="BtnAddCenterPopup_Click"/>
                    <Button x:Name="BtnImport"
                            Style="{StaticResource BaseBtn}"
                            Content="가져오기 (.xlsx/.csv/.json)"
                            Height="30" Padding="10,0" Margin="0,0,6,0"
                            Click="BtnImport_Click"/>
                    <Button x:Name="BtnExport"
                            Style="{StaticResource OxeBtn}"
                            Content="내보내기 (.xlsx/.json)"
                            Height="30" Padding="10,0"
                            Click="BtnExport_Click"/>
                </StackPanel>

                <!-- Left: 4 Sub-Tab Switchers -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSubDialPlan"
                            Style="{StaticResource PrimaryBtn}"
                            Content="Dial-Plan (센터별)"
                            Height="30" Padding="12,0" Margin="0,0,6,0"
                            Click="BtnSubTab_Click" Tag="dialplan"/>
                    <Button x:Name="BtnSubPriEntity"
                            Style="{StaticResource BaseBtn}"
                            Content="PRI · Entity 마스터"
                            Height="30" Padding="12,0" Margin="0,0,6,0"
                            Click="BtnSubTab_Click" Tag="pri"/>
                    <Button x:Name="BtnSubIvrDvg"
                            Style="{StaticResource BaseBtn}"
                            Content="IP IVR · D.V.G 멘트"
                            Height="30" Padding="12,0" Margin="0,0,6,0"
                            Click="BtnSubTab_Click" Tag="ivr"/>
                    <Button x:Name="BtnSubHardware"
                            Style="{StaticResource BaseBtn}"
                            Content="PBX 보드 · 110 Block"
                            Height="30" Padding="12,0"
                            Click="BtnSubTab_Click" Tag="hw"/>
                </WrapPanel>
            </DockPanel>
        </Border>

            <!-- Row 2: Filter & Search Bar -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10,7" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right"
                           x:Name="TxtResultSummary"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="10,0,0,0"/>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status Filter Pills (shown only in Dial-Plan sub-tab) -->
                    <StackPanel x:Name="PanelStatusFilter" Orientation="Horizontal" Margin="0,0,12,0">
                        <Button x:Name="BtnStatusActive" Style="{StaticResource PrimaryBtn}" Content="운영 중 (0)" Height="28" Padding="10,0" Margin="0,0,4,0" Click="BtnStatusFilter_Click" Tag="active"/>
                        <Button x:Name="BtnStatusTest" Style="{StaticResource BaseBtn}" Content="테스트용 (0)" Height="28" Padding="10,0" Margin="0,0,4,0" Click="BtnStatusFilter_Click" Tag="test"/>
                        <Button x:Name="BtnStatusClosed" Style="{StaticResource BaseBtn}" Content="업무 종료 (0)" Height="28" Padding="10,0" Margin="0,0,4,0" Click="BtnStatusFilter_Click" Tag="closed"/>
                        <Button x:Name="BtnStatusAll" Style="{StaticResource BaseBtn}" Content="전체 (0)" Height="28" Padding="10,0" Click="BtnStatusFilter_Click" Tag="all"/>
                    </StackPanel>

                    <!-- D.V.G Band Filter Pills (shown only in IVR/DVG sub-tab) -->
                    <StackPanel x:Name="PanelDvgBandFilter" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,12,0">
                        <Button x:Name="BtnDvgAll" Style="{StaticResource PrimaryBtn}" Content="멘트 전체" Height="28" Padding="9,0" Margin="0,0,4,0" Click="BtnDvgBand_Click" Tag="all"/>
                        <Button x:Name="BtnDvg700" Style="{StaticResource BaseBtn}" Content="700~799" Height="28" Padding="9,0" Margin="0,0,4,0" Click="BtnDvgBand_Click" Tag="700"/>
                        <Button x:Name="BtnDvg800" Style="{StaticResource BaseBtn}" Content="800~899" Height="28" Padding="9,0" Margin="0,0,4,0" Click="BtnDvgBand_Click" Tag="800"/>
                        <Button x:Name="BtnDvg900" Style="{StaticResource BaseBtn}" Content="900~999" Height="28" Padding="9,0" Margin="0,0,4,0" Click="BtnDvgBand_Click" Tag="900"/>
                        <Button x:Name="BtnDvg1800" Style="{StaticResource BaseBtn}" Content="1800~" Height="28" Padding="9,0" Click="BtnDvgBand_Click" Tag="1800"/>
                    </StackPanel>

                    <!-- Location Filter -->
                    <StackPanel x:Name="PanelLocationFilter" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="위치" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbLocationFilter"
                                  Style="{StaticResource ModernComboBox}"
                                  Width="150" Height="28"
                                  SelectionChanged="CmbLocationFilter_SelectionChanged"/>
                    </StackPanel>

                    <!-- Global Live Search -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="검색" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TxtSearch"
                                 Style="{StaticResource ModernTextBox}"
                                 Width="260" Height="28"
                                 ToolTip="센터명, 대표번호, 착신번호, RSI, PG, 내선, Entity, DID, 멘트 내용 검색 (Enter 즉시검색 · Esc 초기화)"
                                 TextChanged="TxtSearch_TextChanged"
                                 KeyDown="TxtSearch_KeyDown"/>
                        <Button x:Name="BtnClearSearch"
                                Style="{StaticResource BaseBtn}"
                                Content="초기화"
                                Height="28" Padding="8,0" Margin="5,0,0,0"
                                Click="BtnClearSearch_Click"/>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

            <!-- Row 3: 4 Sub-Tab Views -->
            <Grid Grid.Row="3">

            <!-- SUB-TAB 1: Dial-Plan (Inline Row Expand + Highlight Border) -->
            <Grid x:Name="PanelDialPlan" Visibility="Visible">
                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <DataGrid x:Name="GridCenters"
                              Style="{StaticResource DialPlanCenteredGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              FrozenColumnCount="3"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowDetailsVisibilityMode="Collapsed"
                              SelectionChanged="GridCenters_SelectionChanged"
                              MouseDoubleClick="GridCenters_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource DialPlanCenteredRowStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding status}" Value="closed">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDetailExpanded}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ChipBgBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Margin" Value="0,2,0,4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="상태" Width="84" SortMemberPath="StatusBadgeText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StatusPill"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="7,2"
                                                MinWidth="64">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse x:Name="StatusDot"
                                                         Width="5.5" Height="5.5"
                                                         Fill="{DynamicResource MutedBrush}"
                                                         Margin="0,0,5,0"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock x:Name="StatusTxt"
                                                           Text="{Binding StatusBadgeText}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding status}" Value="active">
                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource OkBgBrush}"/>
                                                <Setter TargetName="StatusPill" Property="BorderBrush" Value="{DynamicResource OkBorderBrush}"/>
                                                <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource OkFgBrush}"/>
                                                <Setter TargetName="StatusTxt" Property="Foreground" Value="{DynamicResource OkFgBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding status}" Value="test">
                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource WarnBgBrush}"/>
                                                <Setter TargetName="StatusPill" Property="BorderBrush" Value="{DynamicResource WarnBorderBrush}"/>
                                                <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource WarnFgBrush}"/>
                                                <Setter TargetName="StatusTxt" Property="Foreground" Value="{DynamicResource WarnFgBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding status}" Value="closed">
                                                <Setter TargetName="StatusPill" Property="Background" Value="{DynamicResource ErrBgBrush}"/>
                                                <Setter TargetName="StatusPill" Property="BorderBrush" Value="{DynamicResource ErrBorderBrush}"/>
                                                <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource ErrFgBrush}"/>
                                                <Setter TargetName="StatusTxt" Property="Foreground" Value="{DynamicResource ErrFgBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="위치" Binding="{Binding LocationDisplay}" Width="94"/>
                            <DataGridTextColumn Header="프로젝트 (센터명)" Binding="{Binding project}" Width="1.4*" MinWidth="155" ElementStyle="{StaticResource DialPlanBoldTextStyle}"/>
                            <DataGridTextColumn Header="세부업무" Binding="{Binding SubTaskSummary}" Width="1.15*" MinWidth="130"/>
                            <DataGridTextColumn Header="대표번호" Binding="{Binding MainNumberSummary}" Width="1.15*" MinWidth="125" ElementStyle="{StaticResource DialPlanNumericTextStyle}"/>
                            <DataGridTextColumn Header="Entity NO" Binding="{Binding EntitySummary}" Width="0.95*" MinWidth="105" ElementStyle="{StaticResource DialPlanNumericTextStyle}"/>
                            <DataGridTextColumn Header="Agent PG" Binding="{Binding PgSummary}" Width="0.85*" MinWidth="92" ElementStyle="{StaticResource DialPlanNumericTextStyle}"/>
                            <DataGridTextColumn Header="Phone 내선" Binding="{Binding ExtRangeSummary}" Width="1.05*" MinWidth="112" ElementStyle="{StaticResource DialPlanNumericTextStyle}"/>
                            <DataGridTextColumn Header="Login-ID" Binding="{Binding LoginRangeSummary}" Width="1.05*" MinWidth="112" ElementStyle="{StaticResource DialPlanNumericTextStyle}"/>
                            <DataGridTextColumn Header="라인" Binding="{Binding LineCount}" Width="48" ElementStyle="{StaticResource DialPlanNumericTextStyle}"/>
                            <DataGridTemplateColumn Header="Config 연동" Width="1.05*" MinWidth="112" SortMemberPath="CmLinkedSummary">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0">
                                            <Ellipse x:Name="CmDot" Width="5" Height="5" Fill="{DynamicResource OxeBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CmTxt" Text="{Binding CmLinkedSummary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasCmLink}" Value="False">
                                                <Setter TargetName="CmDot" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="CmTxt" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Setter TargetName="CmTxt" Property="FontWeight" Value="Normal"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="AP" Width="84">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="ApCellRoot" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="2,1">
                                            <Button x:Name="BtnApLink"
                                                    Content="{Binding ApDisplayText}"
                                                    ToolTip="{Binding ApToolTipText}"
                                                    ContextMenu="{StaticResource ApCellContextMenu}"
                                                    Cursor="Hand"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Padding="6,2"
                                                    Tag="{Binding}"
                                                    Click="BtnApLink_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ApBd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <TextBlock x:Name="ApTxt"
                                                                       Text="{TemplateBinding Content}"
                                                                       FontSize="12"
                                                                       TextAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding HasApUrl}" Value="False">
                                                                <Setter TargetName="ApTxt" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                                <Setter TargetName="ApTxt" Property="FontWeight" Value="Normal"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasApUrl}" Value="True">
                                                                <Setter TargetName="ApTxt" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                                <Setter TargetName="ApTxt" Property="FontWeight" Value="Bold"/>
                                                                <Setter TargetName="ApTxt" Property="TextDecorations" Value="Underline"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ApBd" Property="Background" Value="{DynamicResource ChipBgBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="상세" Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ExpandButtonText}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Height="23"
                                                Padding="7,0"
                                                FontSize="11.5"
                                                Cursor="Hand"
                                                Tag="{Binding}"
                                                Click="BtnInlineToggle_Click"
                                                ToolTip="행 상세 선번(RSI · IVR · 내선 · Entity) 펼치기 / 접기">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BaseBtn}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDetailExpanded}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <!-- Lazy Per-Row Expandable Detail Content -->
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <ContentControl x:Name="LazyDetailHost"
                                                Content="{Binding}"
                                                Visibility="{Binding IsDetailExpanded, Converter={StaticResource BoolToVisConverter}}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDetailExpanded}" Value="True">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource CenterInlineDetailTemplate}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- SUB-TAB 2: PRI & Entity Master -->
            <Grid x:Name="PanelPriEntity" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="44*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button Style="{StaticResource BaseBtn}" Content="+ PRI 추가" Height="26" Padding="9,0" Margin="0,0,5,0" Click="BtnAddPri_Click"/>
                                <Button Style="{StaticResource BaseBtn}" Content="선택 삭제" Height="26" Padding="9,0" Margin="0,0,5,0" Click="BtnRemovePri_Click"/>
                                <Button Style="{StaticResource PrimaryBtn}" Content="저장" Height="26" Padding="11,0" Click="BtnSaveAllMaster_Click"/>
                            </StackPanel>
                            <TextBlock Text="PRI 회선 현황 (보드 / Logical / TG / DID 대역)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid x:Name="GridPri"
                                  Grid.Row="1"
                                  Style="{StaticResource DialPlanCenteredGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="{Binding IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  BeginningEdit="DataGrid_BeginningEdit"
                                  CellEditEnding="MasterDataGrid_CellEditEnding"
                                  CanUserAddRows="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="실장보드" Binding="{Binding boardSlot, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                <DataGridTextColumn Header="Logical" Binding="{Binding logical, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <DataGridTextColumn Header="TG신규" Binding="{Binding tgNew, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding status, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridTextColumn Header="사용센터" Binding="{Binding centerName, UpdateSourceTrigger=PropertyChanged}" Width="145"/>
                                <DataGridTextColumn Header="트렁크 그룹이름" Binding="{Binding trunkGroupName, UpdateSourceTrigger=PropertyChanged}" Width="135"/>
                                <DataGridTextColumn Header="할당 DID 대역" Binding="{Binding didRange, UpdateSourceTrigger=PropertyChanged}" Width="175"/>
                                <DataGridTextColumn Header="사업자" Binding="{Binding carrier, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridTextColumn Header="DID/DOD" Binding="{Binding didDod, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                <DataGridTextColumn Header="가입자번호" Binding="{Binding subscriberNo, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridTextColumn Header="중계번호" Binding="{Binding relayNo, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                <DataGridTextColumn Header="개통일" Binding="{Binding openedDate, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
                                <DataGridTextColumn Header="비고" Binding="{Binding note, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button Style="{StaticResource BaseBtn}" Content="+ Entity 추가" Height="26" Padding="9,0" Margin="0,0,5,0" Click="BtnAddEntity_Click"/>
                                <Button Style="{StaticResource BaseBtn}" Content="선택 삭제" Height="26" Padding="9,0" Margin="0,0,5,0" Click="BtnRemoveEntity_Click"/>
                                <Button Style="{StaticResource PrimaryBtn}" Content="저장" Height="26" Padding="11,0" Click="BtnSaveAllMaster_Click"/>
                            </StackPanel>
                            <TextBlock Text="OXE Entity NO 마스터 (Sheet2)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid x:Name="GridEntities"
                                  Grid.Row="1"
                                  Style="{StaticResource DialPlanCenteredGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="{Binding IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  BeginningEdit="DataGrid_BeginningEdit"
                                  CellEditEnding="MasterDataGrid_CellEditEnding"
                                  CanUserAddRows="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Entity NO" Binding="{Binding entityNo, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                <DataGridTextColumn Header="엔티티명" Binding="{Binding entityName, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                                <DataGridTextColumn Header="Disc.Num" Binding="{Binding discNum, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                                <DataGridTextColumn Header="비고" Binding="{Binding note, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- SUB-TAB 3: IP IVR & D.V.G Prompts -->
            <Grid x:Name="PanelIvrDvg" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="62*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button Style="{StaticResource BaseBtn}" Content="+ IVR 추가" Height="26" Padding="9,0" Margin="0,0,5,0" Click="BtnAddIpIvr_Click"/>
                                <Button Style="{StaticResource BaseBtn}" Content="선택 삭제" Height="26" Padding="9,0" Margin="0,0,5,0" Click="BtnRemoveIpIvr_Click"/>
                                <Button Style="{StaticResource PrimaryBtn}" Content="저장" Height="26" Padding="11,0" Click="BtnSaveAllMaster_Click"/>
                            </StackPanel>
                            <TextBlock Text="IP IVR 내선 및 채널 할당 현황 (이원화 · SIP)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid x:Name="GridIpIvr"
                                  Grid.Row="1"
                                  Style="{StaticResource DialPlanCenteredGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="{Binding IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  BeginningEdit="DataGrid_BeginningEdit"
                                  CellEditEnding="MasterDataGrid_CellEditEnding"
                                  CanUserAddRows="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="장비명" Binding="{Binding deviceName, UpdateSourceTrigger=PropertyChanged}" Width="210"/>
                                <DataGridTextColumn Header="신규 IVR DN" Binding="{Binding ivrDn, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                                <DataGridTextColumn Header="채널 수" Binding="{Binding channelCount, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                <DataGridTextColumn Header="사용 센터" Binding="{Binding centerName, UpdateSourceTrigger=PropertyChanged}" Width="230"/>
                                <DataGridTextColumn Header="비고 / SIP 정보" Binding="{Binding note, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button Style="{StaticResource BaseBtn}" Content="+ 멘트 추가" Height="26" Padding="9,0" Margin="0,0,5,0" Click="BtnAddDvg_Click"/>
                                <Button Style="{StaticResource BaseBtn}" Content="선택 삭제" Height="26" Padding="9,0" Margin="0,0,5,0" Click="BtnRemoveDvg_Click"/>
                                <Button Style="{StaticResource PrimaryBtn}" Content="저장" Height="26" Padding="11,0" Click="BtnSaveAllMaster_Click"/>
                            </StackPanel>
                            <TextBlock Text="D.V.G 안내 멘트 목록 (700~799 / 800~899 / 900~999 / 1800~)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid x:Name="GridDvg"
                                  Grid.Row="1"
                                  Style="{StaticResource DialPlanCenteredGridStyle}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="{Binding IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  BeginningEdit="DataGrid_BeginningEdit"
                                  CellEditEnding="MasterDataGrid_CellEditEnding"
                                  CanUserAddRows="False"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="대역" Binding="{Binding band, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="D.V.G" Binding="{Binding dvgNo, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridTextColumn Header="구분" Binding="{Binding category, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridTextColumn Header="세부" Binding="{Binding subCategory, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                <DataGridTextColumn Header="안내 멘트 내용" Binding="{Binding content, UpdateSourceTrigger=PropertyChanged}" Width="380"/>
                                <DataGridTextColumn Header="시간(Sec)" Binding="{Binding durationSec, UpdateSourceTrigger=PropertyChanged}" Width="75"/>
                                <DataGridTextColumn Header="보드" Binding="{Binding board, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                <DataGridTextColumn Header="비고" Binding="{Binding note, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- SUB-TAB 4: PBX Hardware (IP / GPA) & MDF 110 Block -->
            <Grid x:Name="PanelHardware" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="54*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="42*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: MAIN / SUB PBX IP & MAC -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button Style="{StaticResource BaseBtn}" Content="+ 보드" Height="25" Padding="8,0" Margin="0,0,4,0" Click="BtnAddHw_Click"/>
                                    <Button Style="{StaticResource BaseBtn}" Content="삭제" Height="25" Padding="8,0" Margin="0,0,4,0" Click="BtnRemoveHw_Click"/>
                                    <Button Style="{StaticResource PrimaryBtn}" Content="저장" Height="25" Padding="10,0" Click="BtnSaveAllMaster_Click"/>
                                </StackPanel>
                                <TextBlock Text="MAIN / SUB PBX 보드 IP · MAC" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid x:Name="GridPbxHw"
                                      Grid.Row="1"
                                      Style="{StaticResource DialPlanCenteredGridStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="{Binding IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      BeginningEdit="DataGrid_BeginningEdit"
                                      CellEditEnding="MasterDataGrid_CellEditEnding"
                                      CanUserAddRows="False"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SET" Binding="{Binding pbxSet, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                                    <DataGridTextColumn Header="실장보드" Binding="{Binding boardSlot, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
                                    <DataGridTextColumn Header="보드명" Binding="{Binding boardName, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                    <DataGridTextColumn Header="IP 정보" Binding="{Binding ipAddress, UpdateSourceTrigger=PropertyChanged}" Width="115"/>
                                    <DataGridTextColumn Header="MAC 정보" Binding="{Binding macAddress, UpdateSourceTrigger=PropertyChanged}" Width="135"/>
                                    <DataGridTextColumn Header="비고" Binding="{Binding note, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Right: GPA Board Remaining Time -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button Style="{StaticResource BaseBtn}" Content="+ GPA" Height="25" Padding="8,0" Margin="0,0,4,0" Click="BtnAddGpa_Click"/>
                                    <Button Style="{StaticResource BaseBtn}" Content="삭제" Height="25" Padding="8,0" Margin="0,0,4,0" Click="BtnRemoveGpa_Click"/>
                                    <Button Style="{StaticResource PrimaryBtn}" Content="저장" Height="25" Padding="10,0" Click="BtnSaveAllMaster_Click"/>
                                </StackPanel>
                                <TextBlock Text="GPA 보드 잔여시간 (D.V.G 용량)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid x:Name="GridGpa"
                                      Grid.Row="1"
                                      Style="{StaticResource DialPlanCenteredGridStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="{Binding IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      BeginningEdit="DataGrid_BeginningEdit"
                                      CellEditEnding="MasterDataGrid_CellEditEnding"
                                      CanUserAddRows="False"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="보드 위치" Binding="{Binding boardLocation, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <DataGridTextColumn Header="잔여시간 정보" Binding="{Binding remainingTime, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                                    <DataGridTextColumn Header="비고" Binding="{Binding note, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

                <!-- Bottom: MDF / 110 Block Grid -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryBtn}" Content="MDF 변경 저장" Height="25" Padding="10,0"
                                    IsEnabled="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Click="BtnSaveMdf_Click"/>
                            <TextBlock Text="MDF / PRI 110 Block 배선 현황" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DataGrid x:Name="GridMdf"
                                  Grid.Row="1"
                                  Style="{StaticResource DialPlanCenteredGridStyle}"
                                  AutoGenerateColumns="True"
                                  AutoGeneratingColumn="GridMdf_AutoGeneratingColumn"
                                  IsReadOnly="{Binding IsViewMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  BeginningEdit="DataGrid_BeginningEdit"
                                  CellEditEnding="MasterDataGrid_CellEditEnding"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
