<Window x:Class="CmOxeProvisioner.Views.EmptyNumberFinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="빈 번호 · 미할당 자원 찾기"
        Width="780" Height="560"
        MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Malgun Gothic, Segoe UI, sans-serif">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="5" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource CaptionCloseBtn}"
                            Width="44" Height="39"
                            Content="✕"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="BtnClose_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Background="{StaticResource ChipBgBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="RESOURCE SCAN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ChipFgBrush}"/>
                        </Border>
                        <TextBlock Text="미할당 번호 찾기 (Entity · 6XX 대역 · IP IVR DN · D.V.G 멘트)"
                                   FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
                <StackPanel>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" x:Name="TxtEntityCount" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="미사용 Entity NO (10 ~ 150 기준)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            </DockPanel>
                            <TextBox x:Name="TxtFreeEntities"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{StaticResource OkFgBrush}"
                                     FontFamily="Consolas, Malgun Gothic"
                                     FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" x:Name="TxtPrefixCount" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="미사용 6XX 센터 대역 (RSI · Pilot · Queue · PG 기준)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            </DockPanel>
                            <TextBox x:Name="TxtFreePrefixes"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{StaticResource ChipFgBrush}"
                                     FontFamily="Consolas, Malgun Gothic"
                                     FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" x:Name="TxtIvrCount" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="미사용 IP IVR DN 대역 (21001~21120 / 22001~22120 / 23001~23100)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            </DockPanel>
                            <TextBox x:Name="TxtFreeIvr"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextBrush}"
                                     FontFamily="Consolas, Malgun Gothic"
                                     FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="미사용 D.V.G 멘트 번호 (대역별)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtFreeDvg"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextBrush}"
                                     FontFamily="Consolas, Malgun Gothic"
                                     FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryBtn}" Content="닫기" Width="90" Height="30" Click="BtnClose_Click"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BaseBtn}" Content="전체 복사" Width="96" Height="30" Margin="0,0,8,0" Click="BtnCopyAll_Click"/>
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Text="운영 중인 센터(업무 종료 제외)와 마스터 시트 기준으로 미사용 자원을 계산합니다."/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
