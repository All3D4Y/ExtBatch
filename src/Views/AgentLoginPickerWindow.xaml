<Window x:Class="CmOxeProvisioner.Views.AgentLoginPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Login 선택 · 분배"
        Icon="pack://application:,,,/ExtBatch;component/icon.ico"
        Width="860"
        Height="640"
        MinWidth="740"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        PreviewMouseLeftButtonUp="PickerWindow_PreviewMouseLeftButtonUp">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="36"
                  ResizeBorderThickness="5"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False"
                  CornerRadius="0" />
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          Background="{DynamicResource AppBgBrush}"
          KeyboardNavigation.TabNavigation="Cycle"
          KeyboardNavigation.ControlTabNavigation="Cycle"
          KeyboardNavigation.DirectionalNavigation="Cycle">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Custom Title Bar -->
      <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="False">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" DockPanel.Dock="Left">
            <Image Source="pack://application:,,,/ExtBatch;component/icon.ico" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TxtDialogHeaderTitle" Text="Agent Login 선택 · 분배" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <Button Click="BtnCancel_Click" Style="{StaticResource CaptionCloseBtn}" DockPanel.Dock="Right" HorizontalAlignment="Right" Focusable="False" IsTabStop="False" ToolTip="닫기 (Esc)">
            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
          </Button>
        </DockPanel>
      </Border>

      <!-- Main Body -->
      <Grid Grid.Row="1" Margin="14,12,14,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP CARD: Agent Login Selection · Distribution · Direct Input -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
          <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <Border Style="{StaticResource BlockTitleAccentStyle}" />
                <TextBlock Text="Agent Login 선택 · 분배" Style="{StaticResource BlockTitleTextStyle}" />
                <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,8,0" VerticalAlignment="Center">
                  <TextBlock x:Name="TxtLoginPoolCount" Text="미조회 (조회 버튼으로 불러오기)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ChipFgBrush}" />
                </Border>
                <Button x:Name="BtnFetchLoginPool" Content="사용 가능 Login 조회" Click="BtnFetchLoginPool_Click" Style="{StaticResource BaseBtn}" Height="25" Padding="9,0" FontSize="11.5" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                <CheckBox x:Name="ChkHideInUseLogins" Content="사용 가능만 보기" IsChecked="False" Checked="ChkHideInUseLogins_Changed" Unchecked="ChkHideInUseLogins_Changed" Style="{StaticResource ModernCheckBox}" FontSize="11.5" />
              </StackPanel>
            </DockPanel>

            <!-- Mode Switcher Bar -->
            <DockPanel LastChildFill="False" Margin="0,0,0,7">
              <Border Background="{DynamicResource SurfaceAltBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="2"
                      DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="BtnDistModeAuto" Content="자동 분배 (다중 선택)" Click="BtnDistModeAuto_Click" Style="{StaticResource SegmentedBtnStyle}" FontSize="11" Padding="9,3" />
                  <Button x:Name="BtnDistModeManual" Content="수동 분배 (1:1 지정)" Click="BtnDistModeManual_Click" Style="{StaticResource SegmentedBtnStyle}" FontSize="11" Padding="9,3" Margin="2,0,0,0" />
                  <Button x:Name="BtnDistModeDirect" Content="직접 입력" Click="BtnDistModeDirect_Click" Style="{StaticResource SegmentedBtnStyle}" FontSize="11" Padding="9,3" Margin="2,0,0,0" />
                </StackPanel>
              </Border>

              <!-- Auto Mode Bar -->
              <StackPanel x:Name="PnlAutoDistBar" Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                <TextBlock x:Name="TxtGalleryPickedCount" Text="선택 0개" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button x:Name="BtnSelectAllAvailLogins" Content="가능 전체 선택" Click="BtnSelectAllAvailLogins_Click" Style="{StaticResource BaseBtn}" Height="25" Padding="8,0" FontSize="11" Margin="0,0,5,0" />
                <Button x:Name="BtnClearLoginPicks" Content="선택 해제" Click="BtnClearLoginPicks_Click" Style="{StaticResource BaseBtn}" Height="25" Padding="8,0" FontSize="11" Margin="0,0,6,0" />
                <Button x:Name="BtnApplyAutoDist" Content="자동 1:1 분배 ↓" Click="BtnApplyAutoDist_Click" Style="{StaticResource PrimaryBtn}" Height="25" Padding="10,0" FontSize="11.5" ToolTip="선택된 Login(미선택 시 사용 가능 전체)을 아래 대상에게 순서대로 1:1 매칭합니다." />
              </StackPanel>

              <!-- Manual Mode Bar -->
              <StackPanel x:Name="PnlManualDistBar" Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Visibility="Collapsed">
                <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="5" Height="25" Padding="9,0" Margin="0,0,6,0" VerticalAlignment="Center">
                  <TextBlock x:Name="TxtManualTargetBadge" Text="대상 행 ▶ (아래 표에서 Person을 선택하세요)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ChipFgBrush}" VerticalAlignment="Center" />
                </Border>
                <Button x:Name="BtnUnassignSelectedRow" Content="선택 행 Login 해제" Click="BtnUnassignSelectedRow_Click" Style="{StaticResource BaseBtn}" Height="25" Padding="8,0" FontSize="11" />
              </StackPanel>

              <!-- Direct Mode Bar -->
              <StackPanel x:Name="PnlDirectDistBar" Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Visibility="Collapsed">
                <Button x:Name="BtnImportCtiLogins" Content="내선·CTI 탭에서 가져오기" Click="BtnImportCtiLogins_Click" Style="{StaticResource BaseBtn}" Height="25" Padding="9,0" FontSize="11" />
              </StackPanel>
            </DockPanel>

            <!-- Gallery Host -->
            <StackPanel x:Name="PnlGalleryHost" Visibility="Visible">
              <Border Background="{DynamicResource InputBgBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="5">
                <Grid MinHeight="126">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="145">
                    <ItemsControl x:Name="IcLoginPool">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="3"
                                  Background="Transparent"
                                  Cursor="Hand"
                                  MouseLeftButtonDown="LoginTile_MouseLeftButtonDown"
                                  MouseEnter="LoginTile_MouseEnter">
                            <Border x:Name="TileCard"
                                    Width="104"
                                    Height="46"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    BorderThickness="1"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}">
                              <Grid>
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="{Binding LoginId}"
                                             FontFamily="Consolas"
                                             FontSize="12.5"
                                             FontWeight="Bold"
                                             Foreground="{DynamicResource TextBrush}" />
                                  <TextBlock x:Name="TxtTileStatus"
                                             Text="{Binding StatusCaption}"
                                             FontSize="10"
                                             TextTrimming="CharacterEllipsis"
                                             Foreground="{DynamicResource MutedBrush}"
                                             Margin="0,1,0,0" />
                                </StackPanel>

                                <Border x:Name="PickOrderBadge"
                                        Visibility="{Binding PickBadgeVisibility}"
                                        Width="18" Height="18"
                                        CornerRadius="9"
                                        Background="{DynamicResource PrimaryBrush}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-1,-2,0">
                                  <TextBlock Text="{Binding PickOrderText}"
                                             FontSize="10"
                                             FontWeight="Bold"
                                             Foreground="{DynamicResource PrimaryFgBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Border>
                              </Grid>
                            </Border>
                          </Border>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAssignedToTable}" Value="True">
                              <Setter TargetName="TileCard" Property="Background" Value="{DynamicResource OkBgBrush}" />
                              <Setter TargetName="TileCard" Property="BorderBrush" Value="{DynamicResource OkBorderBrush}" />
                              <Setter TargetName="TxtTileStatus" Property="Foreground" Value="{DynamicResource OkFgBrush}" />
                              <Setter TargetName="TxtTileStatus" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPicked}" Value="True">
                              <Setter TargetName="TileCard" Property="Background" Value="{DynamicResource ChipBgBrush}" />
                              <Setter TargetName="TileCard" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                              <Setter TargetName="TileCard" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInUseInCm}" Value="True">
                              <Setter TargetName="TileCard" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                              <Setter TargetName="TileCard" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                              <Setter TargetName="TileCard" Property="Opacity" Value="0.44" />
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                  <StackPanel x:Name="PnlEmptyGalleryHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="상단 [사용 가능 Login 조회]를 누르면 CM에서 미사용 Agent Login 목록을 불러와 클릭·드래그로 선택하고 분배할 수 있습니다." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="14,0" />
                  </StackPanel>
                </Grid>
              </Border>

              <TextBlock x:Name="TxtGalleryTip"
                         Text="💡 [자동 분배] Ctrl 키 없이 클릭·드래그로 다중 선택한 뒤 [자동 1:1 분배 ↓]를 누르세요. (미선택 시 사용 가능 전체 순차 분배)"
                         FontSize="11"
                         Foreground="{DynamicResource MutedBrush}"
                         Margin="2,5,0,0" />
            </StackPanel>

            <!-- Direct Input Area -->
            <Border x:Name="PnlDirectInputHost"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,9">
              <StackPanel>
                <TextBlock Text="Agent Login ID 직접 입력 (쉼표, 공백, 줄바꿈 또는 ~ 범위로 대상에게 순서대로 1:1 매핑)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Grid Grid.Column="0">
                    <TextBox x:Name="TxtRuleLogins" Style="{StaticResource ModernTextBox}" Height="34" FontFamily="Consolas" />
                    <TextBlock Text="예: 70101~70105 또는 70101, 70104, 70109" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Opacity="0.6" VerticalAlignment="Center" Margin="10,0,8,0" IsHitTestVisible="False">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=TxtRuleLogins}" Value="">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>

                  <Button x:Name="BtnApplyDirectLogins" Grid.Column="2" Content="대상에 적용 ↓" Click="BtnApplyDirectLogins_Click" Style="{StaticResource PrimaryBtn}" Height="34" Padding="12,0" />
                  <Button x:Name="BtnClearAllDraftLogins" Grid.Column="4" Content="대상 Login 일괄 해제" Click="BtnClearAllDrafts_Click" Style="{StaticResource BaseBtn}" Height="34" Padding="10,0" />
                </Grid>
                <TextBlock x:Name="TxtDirectLoginStatus" Text="※ [사용 가능 Login 조회] 후 적용하면 사용 중 여부도 함께 확인할 수 있습니다." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- BOTTOM CARD: Target Person Agent Login Mapping Preview -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <Border Style="{StaticResource BlockTitleAccentStyle}" />
                <TextBlock Text="배정 대상 Person 미리보기" Style="{StaticResource BlockTitleTextStyle}" />
                <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="TxtTargetSummary" Text="대상 0명 · 변경 0건" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ChipFgBrush}" />
                </Border>
              </StackPanel>

              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                <Button x:Name="BtnRestoreOriginalLogins" Content="기존값 복원" Click="BtnRestoreOriginalLogins_Click" Style="{StaticResource BaseBtn}" Height="25" Padding="9,0" FontSize="11" Margin="0,0,6,0" />
                <Button x:Name="BtnUnassignAllTargets" Content="전체 Login 해제 (삭제)" Click="BtnClearAllDrafts_Click" Style="{StaticResource DangerBtn}" Height="25" Padding="9,0" FontSize="11" ToolTip="대상 Person의 Agent Login 연결을 모두 해제합니다." />
              </StackPanel>
            </DockPanel>

            <DataGrid x:Name="DgTargets"
                      Grid.Row="1"
                      Style="{StaticResource ModernDataGrid}"
                      AutoGenerateColumns="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="DgTargets_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeId}" IsReadOnly="True" MinWidth="105" Width="1.15*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontFamily" Value="Consolas" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="User Name" Binding="{Binding UserName}" IsReadOnly="True" MinWidth="95" Width="1.1*" />

                <DataGridTextColumn Header="기존 Login" Binding="{Binding OriginalLoginDisplay}" IsReadOnly="True" MinWidth="95" Width="0.95*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontFamily" Value="Consolas" />
                      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="변경 후 Login" Binding="{Binding DraftLoginDisplay}" IsReadOnly="True" MinWidth="135" Width="1.25*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontFamily" Value="Consolas" />
                      <Setter Property="FontWeight" Value="Bold" />
                      <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="구분" Binding="{Binding DeltaLabel}" IsReadOnly="True" MinWidth="82" Width="0.78*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                      <Setter Property="FontSize" Value="11" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                      <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="해제" Width="94" MinWidth="94" CanUserResize="False">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="Login 삭제"
                              Click="BtnClearSingleTargetRow_Click"
                              Style="{StaticResource BaseBtn}"
                              Height="24"
                              Padding="8,0"
                              FontSize="11"
                              ToolTip="이 Person의 Agent Login 연결을 해제합니다." />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>

      <!-- Bottom Action Footer -->
      <Border Grid.Row="2"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="14,10">
        <DockPanel LastChildFill="False">
          <TextBlock Text="※ [적용] 시 목록에 임시 반영되며, 하단 [수정 반영] 실행 시 CM Agent Info(Add ID / Delete ID)에 최종 저장됩니다."
                     FontSize="11"
                     Foreground="{DynamicResource MutedBrush}"
                     VerticalAlignment="Center"
                     DockPanel.Dock="Left" />

          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button x:Name="BtnCancel" Content="취소" Click="BtnCancel_Click" Style="{StaticResource BaseBtn}" MinWidth="78" Margin="0,0,8,0" />
            <Button x:Name="BtnConfirmApply" Content="적용" Click="BtnConfirmApply_Click" Style="{StaticResource PrimaryBtn}" MinWidth="92" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
