<Window x:Class="CmOxeProvisioner.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:CmOxeProvisioner.Views"
        Title="ExtBatch — Genesys CM · Alcatel OXE · Person 통합 관리"
        Icon="pack://application:,,,/ExtBatch;component/icon.ico"
        Width="1480" Height="850"
        MinWidth="1040" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False"
                  CornerRadius="0" />
  </WindowChrome.WindowChrome>

  <Border x:Name="RootFrame"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          Background="{DynamicResource AppBgBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- ==================== CUSTOM THEMED TITLE BAR (Global Shell) ==================== -->
      <Border Grid.Row="0"
              Background="{DynamicResource HeaderBgBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Left: Brand & Title -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,10,0">
            <Image Source="pack://application:,,,/ExtBatch;component/icon.ico" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="ExtBatch" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="TxtAppVersion" Text="v1.0.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="6,1,0,0" />
            <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="CM · OXE · Person" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ChipFgBrush}" />
            </Border>
            <TextBlock Text="통합 프로비저닝 관리" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>

          <!-- Center: Clean Drag Area -->
          <Border Grid.Column="1" Background="Transparent" />

          <!-- Right: Unified CM Toggle Pill + Gear Settings Icon Button + Caption Buttons -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnConnectCm"
                    Content="CM 미연결"
                    Tag="Connect"
                    Click="BtnConnectCm_Click"
                    Style="{StaticResource CmTogglePillStyle}"
                    Margin="0,0,6,0" />

            <Button x:Name="BtnSettings"
                    Click="BtnSettings_Click"
                    Style="{StaticResource BaseBtn}"
                    Width="30" Height="28" Padding="0"
                    Margin="0,0,10,0"
                    ToolTip="설정"
                    WindowChrome.IsHitTestVisibleInChrome="True">
              <Viewbox Width="15" Height="15" Stretch="Uniform">
                <Canvas Width="24" Height="24">
                  <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        Data="F0 M 11,4.97 L 11.15,2.24 L 12.85,2.24 L 13,4.97 L 16.26,6.32 L 18.31,4.5 L 19.5,5.69 L 17.68,7.74 L 19.03,11 L 21.76,11.15 L 21.76,12.85 L 19.03,13 L 17.68,16.26 L 19.5,18.31 L 18.31,19.5 L 16.26,17.68 L 13,19.03 L 12.85,21.76 L 11.15,21.76 L 11,19.03 L 7.74,17.68 L 5.69,19.5 L 4.5,18.31 L 6.32,16.26 L 4.97,13 L 2.24,12.85 L 2.24,11.15 L 4.97,11 L 6.32,7.74 L 4.5,5.69 L 5.69,4.5 L 7.74,6.32 Z M 12,8.5 A 3.5,3.5 0 1 0 12,15.5 A 3.5,3.5 0 1 0 12,8.5 Z" />
                </Canvas>
              </Viewbox>
            </Button>

            <Border Width="1" Height="20" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="0,0,2,0" />
            <Button Click="BtnMin_Click" Style="{StaticResource CaptionBtn}" Height="43" ToolTip="최소화">
              <Path Data="M 0,5 L 10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
            </Button>
            <Button x:Name="BtnMaxRestore" Click="BtnMaxRestore_Click" Style="{StaticResource CaptionBtn}" Height="43" ToolTip="최대화 / 복원">
              <Grid Width="10" Height="10">
                <Path x:Name="MaxRectPath" Data="M 0,0 H 10 V 10 H 0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" />
                <Path x:Name="RestoreRectPath" Data="M 2,2 V 0 H 10 V 8 H 8 M 0,2 H 8 V 10 H 0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Visibility="Collapsed" />
              </Grid>
            </Button>
            <Button Click="BtnClose_Click" Style="{StaticResource CaptionCloseBtn}" Height="43" ToolTip="닫기">
              <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ==================== MAIN SHELL: LEFT SIDEBAR + BROWSER TAB HOST ==================== -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ColSidebar" Width="186" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
          <DockPanel LastChildFill="True">
            <!-- Sidebar Header & Collapse Toggle -->
            <DockPanel DockPanel.Dock="Top" Margin="10,10,8,8">
              <TextBlock x:Name="TxtSidebarHeader"
                         Text="기능 메뉴"
                         FontSize="11"
                         FontWeight="Bold"
                         Foreground="{DynamicResource MutedBrush}"
                         VerticalAlignment="Center"
                         DockPanel.Dock="Left" />
              <Button x:Name="BtnToggleSidebar"
                      Click="BtnToggleSidebar_Click"
                      Style="{StaticResource BaseBtn}"
                      Width="26" Height="24" Padding="0"
                      DockPanel.Dock="Right"
                      HorizontalAlignment="Right"
                      ToolTip="사이드바 접기 / 펼치기">
                <TextBlock x:Name="TxtSidebarToggleGlyph" Text="«" FontSize="12" FontWeight="Bold" Margin="0,-2,0,0" />
              </Button>
            </DockPanel>

            <!-- Sidebar Footer -->
            <Border x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="10,6,10,10" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,7">
              <TextBlock Text="좌측 메뉴를 클릭하면&#x0a;우측 탭으로 열립니다." FontSize="10.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="15" />
            </Border>

            <!-- Navigation Items -->
            <StackPanel Margin="8,2">
              <Button x:Name="BtnNavExtCti"
                      Click="BtnNavExtCti_Click"
                      Height="38"
                      Padding="10,0"
                      Margin="0,0,0,5"
                      Cursor="Hand"
                      HorizontalContentAlignment="Stretch"
                      BorderThickness="1"
                      ToolTip="내선 · CTI 일괄 생성/삭제 및 LightGate 터미널">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="NavBd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="NavBd" Property="Opacity" Value="0.88" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Viewbox Grid.Column="0" Width="15" Height="15" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="M 6.62,10.79 C 8.06,13.62 10.38,15.94 13.21,17.38 L 15.41,15.18 C 15.69,14.9 16.08,14.82 16.43,14.93 C 17.55,15.3 18.75,15.5 20,15.5 A 1,1 0 0 1 21,16.5 V 20 A 1,1 0 0 1 20,21 C 10.61,21 3,13.39 3,4 A 1,1 0 0 1 4,3 H 7.5 A 1,1 0 0 1 8.5,4 C 8.5,5.25 8.7,6.45 9.07,7.57 C 9.18,7.92 9.1,8.31 8.82,8.59 L 6.62,10.79 Z" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock x:Name="TxtNavExtCtiLabel" Grid.Column="1" Text="내선 · CTI" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,4,0" />
                  <Ellipse x:Name="DotNavExtCti" Grid.Column="2" Width="6" Height="6" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Visibility="Visible" />
                </Grid>
              </Button>

              <Button x:Name="BtnNavPerson"
                      Click="BtnNavPerson_Click"
                      Height="38"
                      Padding="10,0"
                      Margin="0,0,0,5"
                      Cursor="Hand"
                      HorizontalContentAlignment="Stretch"
                      BorderThickness="1"
                      ToolTip="CM 상담사(Person) 일괄 생성 · 관리">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="NavBd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="NavBd" Property="Opacity" Value="0.88" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Viewbox Grid.Column="0" Width="15" Height="15" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="M 12,12 C 14.21,12 16,10.21 16,8 C 16,5.79 14.21,4 12,4 C 9.79,4 8,5.79 8,8 C 8,10.21 9.79,12 12,12 Z M 12,14 C 9.33,14 4,15.34 4,18 V 20 H 20 V 18 C 20,15.34 14.67,14 12,14 Z" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock x:Name="TxtNavPersonLabel" Grid.Column="1" Text="Person 관리" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,4,0" />
                  <Ellipse x:Name="DotNavPerson" Grid.Column="2" Width="6" Height="6" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
              </Button>

              <Button x:Name="BtnNavDialPlan"
                      Click="BtnNavDialPlan_Click"
                      Height="38"
                      Padding="10,0"
                      Margin="0,0,0,5"
                      Cursor="Hand"
                      HorizontalContentAlignment="Stretch"
                      BorderThickness="1"
                      ToolTip="선번장(Dial-Plan / PRI / IVR / 멘트 / MDF) 및 센터 추가·수정·삭제">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="NavBd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="NavBd" Property="Opacity" Value="0.88" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Viewbox Grid.Column="0" Width="15" Height="15" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="M 3,4 H 21 V 8 H 3 V 4 Z M 3,10 H 10 V 20 H 3 V 10 Z M 12,10 H 21 V 14 H 12 V 10 Z M 12,16 H 21 V 20 H 12 V 16 Z" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock x:Name="TxtNavDialPlanLabel" Grid.Column="1" Text="선번장 · 센터" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,4,0" />
                  <Ellipse x:Name="DotNavDialPlan" Grid.Column="2" Width="6" Height="6" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- RIGHT SIDE: BROWSER TAB BAR + ACTIVE TAB VIEWPORT -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- BROWSER-STYLE TAB STRIP -->
          <Border Grid.Row="0"
                  Background="{DynamicResource HeaderBgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="10,6,10,0">
            <StackPanel x:Name="TabStripPanel" Orientation="Horizontal" VerticalAlignment="Bottom" />
          </Border>

          <!-- TAB CONTENT HOST -->
          <Grid Grid.Row="1">

            <!-- TAB 1 ROOT: 내선 · CTI 일괄 관리 (Split/Work/LightGate Sub-Toolbar Inside Tab!) -->
            <Grid x:Name="ExtCtiTabRoot" Visibility="Visible">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- Tab-Local Sub-Toolbar -->
              <Border Grid.Row="0"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="14,7">
                <DockPanel LastChildFill="False">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Style="{StaticResource BlockTitleAccentStyle}" />
                    <TextBlock Text="내선 · CTI 관리" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="CM (Agent DN · Place · Login · ACD) · PBX (LightGate)" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="9,0,0,0" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <TextBlock Text="화면 구성" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="2">
                      <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnTabSplit" Content="Split" Click="BtnTabSplit_Click" Style="{StaticResource SegmentedBtnStyle}" />
                        <Button x:Name="BtnTabWork" Content="Workspace" Click="BtnTabWork_Click" Style="{StaticResource SegmentedBtnStyle}" Margin="2,0,0,0" />
                        <Button x:Name="BtnTabLightGate" Content="LightGate" Click="BtnTabLightGate_Click" Style="{StaticResource SegmentedBtnStyle}" Margin="2,0,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </DockPanel>
              </Border>

              <!-- SPLIT / WORK / LIGHTGATE BODY -->
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="ColWork" Width="1.08*" MinWidth="420" />
                  <ColumnDefinition x:Name="ColSplitter" Width="6" />
                  <ColumnDefinition x:Name="ColEms" Width="1*" MinWidth="350" />
                </Grid.ColumnDefinitions>

        <!-- LEFT PANE: WORKSPACE -->
        <ScrollViewer x:Name="WorkPane" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="14">
          <StackPanel>

            <!-- BLOCK 1: 센터 (Dropdown Left + Search with Magnifier Right + CM Paths) -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
              <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Style="{StaticResource BlockTitleAccentStyle}" />
                    <TextBlock Text="센터" Style="{StaticResource BlockTitleTextStyle}" />
                    <TextBlock x:Name="LblCustHeader" Text="(0개)" Style="{StaticResource BlockSubtitleTextStyle}" />
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="5" Height="26" Padding="9,0" Margin="0,0,6,0" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtFloorBadge" Text="-" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ChipFgBrush}" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="BdPathWarn" Visibility="Collapsed" Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1" CornerRadius="5" Height="26" Padding="8,0" Margin="0,0,6,0" VerticalAlignment="Center">
                      <TextBlock Text="경로 확인" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WarnFgBrush}" VerticalAlignment="Center" />
                    </Border>
                    <Button x:Name="BtnTogglePaths" Content="CM 경로 ▾" Click="BtnTogglePaths_Click" Style="{StaticResource BaseBtn}" Height="26" Padding="9,0" FontSize="11.5" />
                  </StackPanel>
                </DockPanel>

                <!-- Customer Dropdown (Left) + Search Box with Magnifier Icon (Right) -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.65*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1*" />
                  </Grid.ColumnDefinitions>

                  <Grid Grid.Column="0">
                    <ComboBox x:Name="CmbCustomer" Style="{StaticResource ModernComboBox}" Height="34" SelectionChanged="CmbCustomer_SelectionChanged" />
                    <TextBlock Text="센터를 선택하거나 검색..."
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               Opacity="0.65"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="11,0,28,0"
                               IsHitTestVisible="False">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedItem, ElementName=CmbCustomer}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>

                  <Border Grid.Column="2" Style="{StaticResource SearchBoxFrameStyle}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <Viewbox Grid.Column="0" Width="14" Height="14" Margin="10,0,6,0" VerticalAlignment="Center">
                        <Canvas Width="16" Height="16">
                          <Ellipse Canvas.Left="2" Canvas.Top="2" Width="9" Height="9" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" />
                          <Line X1="9.8" Y1="9.8" X2="14" Y2="14" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                      </Viewbox>

                      <Grid Grid.Column="1">
                        <TextBlock Text="검색..." FontSize="12" Foreground="{DynamicResource MutedBrush}" Opacity="0.65" VerticalAlignment="Center" Margin="2,0,8,0" IsHitTestVisible="False">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="TxtSearch"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 BorderThickness="0"
                                 FontSize="12"
                                 Padding="0,2,8,2"
                                 VerticalContentAlignment="Center"
                                 UseLayoutRounding="True"
                                 TextChanged="TxtSearch_TextChanged" />
                      </Grid>
                    </Grid>
                  </Border>
                </Grid>

                <!-- Collapsible CM 4 Paths + VQueue / IVR On-Demand Apply -->
                <Border x:Name="BdCmPaths" Visibility="Collapsed"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock x:Name="TxtPathLogin" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,2" />
                    <TextBlock x:Name="TxtPathAcd" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,2" />
                    <TextBlock x:Name="TxtPathDn" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,2" />
                    <TextBlock x:Name="TxtPathPlace" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtPathNote" FontSize="12" Foreground="{DynamicResource WarnFgBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />

                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                      <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                          <TextBlock Text="선택 CM 구성 (VQueue · IVR)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                          <TextBlock x:Name="TxtCmOptionSyncState" Text="센터 미선택" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Right" />
                        </DockPanel>
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <CheckBox x:Name="ChkCenterVQueue" Content="VQueue 사용" Checked="ChkCenterOption_Changed" Unchecked="ChkCenterOption_Changed" Style="{StaticResource ModernCheckBox}" Margin="0,2,14,2" />
                          <CheckBox x:Name="ChkCenterIvr" Content="IVR 사용 (Place Group)" Checked="ChkCenterOption_Changed" Unchecked="ChkCenterOption_Changed" Style="{StaticResource ModernCheckBox}" Margin="0,2,12,2" />
                          <Button x:Name="BtnCheckCenterOpts" Content="상태 조회" Click="BtnCheckCenterOpts_Click" Style="{StaticResource BaseBtn}" Height="26" Padding="9,0" FontSize="11.5" Margin="0,2,6,2" />
                          <Button x:Name="BtnApplyCenterOpts" Content="적용하기" Click="BtnApplyCenterOpts_Click" Style="{StaticResource PrimaryBtn}" Height="26" Padding="11,0" FontSize="11.5" Margin="0,2,0,2" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- BLOCK 2: 내선/로그인ID 입력 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
              <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,9">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Style="{StaticResource BlockTitleAccentStyle}" />
                    <TextBlock Text="내선/로그인ID 입력" Style="{StaticResource BlockTitleTextStyle}" />
                  </StackPanel>
                  <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center" DockPanel.Dock="Right">
                    <TextBlock x:Name="TxtLiveCount" Text="내선 0건 · CTI 0건" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource ChipFgBrush}" />
                  </Border>
                </DockPanel>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <DockPanel LastChildFill="False" Margin="0,0,0,5">
                      <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <TextBlock Text="내선번호" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ChipFgBrush}" />
                      </Border>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                        <TextBlock x:Name="TxtDnTag" Text="0건" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        <Border x:Name="BdDnErr" Visibility="Collapsed" Margin="6,0,0,0" CornerRadius="4" Padding="6,1" Background="{DynamicResource ErrBgBrush}" BorderBrush="{DynamicResource ErrBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                          <TextBlock x:Name="TxtDnErrCount" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ErrFgBrush}" />
                        </Border>
                      </StackPanel>
                    </DockPanel>
                    <AdornerDecorator>
                      <Grid>
                        <TextBox x:Name="TxtDn" Style="{StaticResource ModernTextBox}" Padding="9,6" FontFamily="Consolas" AcceptsReturn="True" VerticalContentAlignment="Top" Height="68" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="TxtNumbers_TextChanged" MouseMove="TxtNumbers_MouseMove" />
                        <StackPanel IsHitTestVisible="False" Margin="10,7,10,6" VerticalAlignment="Top">
                          <StackPanel.Style>
                            <Style TargetType="StackPanel">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtDn}" Value="">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </StackPanel.Style>
                          <TextBlock Text="여러 개일 때 공백, 줄바꿈, 쉼표로 구분" FontSize="11" Foreground="{DynamicResource MutedBrush}" Opacity="0.68" LineHeight="17" />
                          <TextBlock Text="범위는 ~로 (예: 31001~31005)" FontSize="11" Foreground="{DynamicResource MutedBrush}" Opacity="0.68" LineHeight="17" />
                          <TextBlock Text="*대량 입력엔 주의" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarnFgBrush}" Opacity="0.78" LineHeight="17" />
                        </StackPanel>
                      </Grid>
                    </AdornerDecorator>
                    <TextBlock x:Name="TxtDnErrHint" Visibility="Collapsed" FontSize="11" Foreground="{DynamicResource ErrFgBrush}" TextWrapping="Wrap" Margin="2,4,2,0" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <DockPanel LastChildFill="False" Margin="0,0,0,5">
                      <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center" DockPanel.Dock="Left">
                        <TextBlock Text="CTI" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ChipFgBrush}" />
                      </Border>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right">
                        <TextBlock x:Name="TxtCtiTag" Text="0건" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        <Border x:Name="BdCtiErr" Visibility="Collapsed" Margin="6,0,0,0" CornerRadius="4" Padding="6,1" Background="{DynamicResource ErrBgBrush}" BorderBrush="{DynamicResource ErrBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                          <TextBlock x:Name="TxtCtiErrCount" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ErrFgBrush}" />
                        </Border>
                      </StackPanel>
                    </DockPanel>
                    <AdornerDecorator>
                      <Grid>
                        <TextBox x:Name="TxtCti" Style="{StaticResource ModernTextBox}" Padding="9,6" FontFamily="Consolas" AcceptsReturn="True" VerticalContentAlignment="Top" Height="68" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="TxtNumbers_TextChanged" MouseMove="TxtNumbers_MouseMove" />
                        <StackPanel IsHitTestVisible="False" Margin="10,7,10,6" VerticalAlignment="Top">
                          <StackPanel.Style>
                            <Style TargetType="StackPanel">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtCti}" Value="">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </StackPanel.Style>
                          <TextBlock Text="여러 개일 때 공백, 줄바꿈, 쉼표로 구분" FontSize="11" Foreground="{DynamicResource MutedBrush}" Opacity="0.68" LineHeight="17" />
                          <TextBlock Text="범위는 ~로 (예: 71001~71005)" FontSize="11" Foreground="{DynamicResource MutedBrush}" Opacity="0.68" LineHeight="17" />
                          <TextBlock Text="*대량 입력엔 주의" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarnFgBrush}" Opacity="0.78" LineHeight="17" />
                        </StackPanel>
                      </Grid>
                    </AdornerDecorator>
                    <TextBlock x:Name="TxtCtiErrHint" Visibility="Collapsed" FontSize="11" Foreground="{DynamicResource ErrFgBrush}" TextWrapping="Wrap" Margin="2,4,2,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- BLOCK 3: PBX -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
              <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,9">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Style="{StaticResource BlockTitleAccentStyle}" />
                    <TextBlock Text="PBX" Style="{StaticResource BlockTitleTextStyle}" />
                    <TextBlock Text="(입력된 번호 기준)" Style="{StaticResource BlockSubtitleTextStyle}" />
                  </StackPanel>
                </DockPanel>

                <!-- Preset / Entity NO / Agent PG / 기준 Profile (OXE Parameters) -->
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.35*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Preset" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="CmbOxePreset" Style="{StaticResource ModernComboBox}" Height="34" SelectionChanged="CmbOxePreset_SelectionChanged" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Entity NO" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TxtEntityNo" Style="{StaticResource ModernTextBox}" Height="34" FontFamily="Consolas" />
                  </StackPanel>

                  <StackPanel Grid.Column="4">
                    <TextBlock Text="Agent PG" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TxtAgentPg" Style="{StaticResource ModernTextBox}" Height="34" FontFamily="Consolas" />
                  </StackPanel>

                  <StackPanel Grid.Column="6">
                    <TextBlock Text="기준 Profile (내선 / Login)" Style="{StaticResource FieldLabelStyle}" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="TxtProfExt" Grid.Column="0" Style="{StaticResource ModernTextBox}" Height="34" FontFamily="Consolas" />
                      <TextBox x:Name="TxtProfLogin" Grid.Column="2" Style="{StaticResource ModernTextBox}" Height="34" FontFamily="Consolas" />
                    </Grid>
                  </StackPanel>
                </Grid>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="BtnOxeCheck" Content="내선/CTI ID 검색" Click="BtnOxeCheck_Click" Style="{StaticResource BaseBtn}" Margin="0,2,6,2" />
                  <Button x:Name="BtnOxeCreateSendOrCopy" Content="생성 스크립트 전송/복사" Click="BtnOxeCreateSendOrCopy_Click" Style="{StaticResource PrimaryBtn}" Margin="0,2,6,2" />
                  <Button x:Name="BtnOxeDeleteSendOrCopy" Content="삭제 스크립트 전송/복사" Click="BtnOxeDeleteSendOrCopy_Click" Style="{StaticResource DangerBtn}" Margin="0,2,6,2" />
                  <Button x:Name="BtnOxeSaveSh" Content=".sh 저장" Click="BtnOxeSaveSh_Click" Style="{StaticResource BaseBtn}" Margin="0,2,0,2" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- BLOCK 4: CM -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
              <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,9">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Style="{StaticResource BlockTitleAccentStyle}" />
                    <TextBlock Text="CM" Style="{StaticResource BlockTitleTextStyle}" />
                  </StackPanel>
                  <CheckBox x:Name="ChkCheckAll" Content="Check All" IsChecked="True" Checked="ChkMaster_Changed" Unchecked="ChkMaster_Changed" Style="{StaticResource ModernCheckBox}" FontWeight="SemiBold" DockPanel.Dock="Right" />
                </DockPanel>

                <!-- 4 Checkboxes: 내선 [Agent DN, Place(+Shortcut)] | CTI [Agent Login, ACD Position] -->
                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,9">
                  <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,18,2">
                      <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="4" Padding="7,2" Margin="0,0,10,0">
                        <TextBlock Text="내선" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ChipFgBrush}" />
                      </Border>
                      <CheckBox x:Name="ChkAgentDn" Content="Agent DN" IsChecked="True" Checked="ChkItem_Changed" Unchecked="ChkItem_Changed" Style="{StaticResource ModernCheckBox}" Margin="0,0,12,0" />
                      <CheckBox x:Name="ChkPlace" Content="Place(+Shortcut)" IsChecked="True" Checked="ChkItem_Changed" Unchecked="ChkItem_Changed" Style="{StaticResource ModernCheckBox}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                      <Border Background="{DynamicResource ChipBgBrush}" CornerRadius="4" Padding="7,2" Margin="0,0,10,0">
                        <TextBlock Text="CTI" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource ChipFgBrush}" />
                      </Border>
                      <CheckBox x:Name="ChkAgentLogin" Content="Agent Login" IsChecked="True" Checked="ChkItem_Changed" Unchecked="ChkItem_Changed" Style="{StaticResource ModernCheckBox}" Margin="0,0,12,0" />
                      <CheckBox x:Name="ChkAcdPos" Content="ACD Position" IsChecked="True" Checked="ChkItem_Changed" Unchecked="ChkItem_Changed" Style="{StaticResource ModernCheckBox}" />
                    </StackPanel>
                  </WrapPanel>
                </Border>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="BtnCmCheck" Content="내선/CTI ID 검색" Click="BtnCmCheck_Click" Style="{StaticResource BaseBtn}" Margin="0,2,6,2" />
                  <Button x:Name="BtnCmCreate" Content="CM 일괄 생성" Click="BtnCmCreate_Click" Style="{StaticResource PrimaryBtn}" Margin="0,2,6,2" />
                  <Button x:Name="BtnCmDelete" Content="CM 일괄 삭제" Click="BtnCmDelete_Click" Style="{StaticResource DangerBtn}" Margin="0,2,0,2" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- BLOCK 5: Log Console -->
            <Border Style="{StaticResource CardBorderStyle}">
              <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,9">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <Border Style="{StaticResource BlockTitleAccentStyle}" />
                    <TextBlock Text="Log" Style="{StaticResource BlockTitleTextStyle}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="BtnSaveLog" Content="Save" Click="BtnSaveLog_Click" Style="{StaticResource BaseBtn}" Height="26" Padding="9,0" FontSize="11.5" Margin="0,0,6,0" />
                    <Button x:Name="BtnClearLog" Content="Clear" Click="BtnClearLog_Click" Style="{StaticResource BaseBtn}" Height="26" Padding="9,0" FontSize="11.5" />
                  </StackPanel>
                </DockPanel>

                <Border Background="{DynamicResource ConsoleBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                  <TextBox x:Name="TxtLog"
                           Height="135"
                           IsReadOnly="True"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           Background="Transparent"
                           Foreground="{DynamicResource ConsoleFgBrush}"
                           BorderThickness="0"
                           FontFamily="Consolas"
                           FontSize="12"
                           Padding="10" />
                </Border>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- SPLITTER (Split Mode Only) -->
        <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}" Visibility="Visible" />

        <!-- RIGHT / LIGHTGATE TAB PANE -->
        <Grid x:Name="EmsPane" Grid.Column="2" Visibility="Visible" Margin="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                <Button x:Name="BtnEmsTerminalToggle"
                        Content="LightGate 준비 중"
                        Tag="Connect"
                        Click="BtnEmsTerminalToggle_Click"
                        Style="{StaticResource CmTogglePillStyle}"
                        WindowChrome.IsHitTestVisibleInChrome="False"
                        Margin="0,0,6,0" />
                <Button x:Name="BtnEmsPageReload"
                        Click="BtnEmsPageReload_Click"
                        Style="{StaticResource BaseBtn}"
                        Width="28" Height="28" Padding="0"
                        Margin="0,0,10,0"
                        ToolTip="LightGate 페이지 새로고침">
                  <Viewbox Width="14" Height="14" Stretch="Uniform">
                    <Canvas Width="24" Height="24">
                      <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4.01,7.58 4.01,12 C 4.01,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 L 17.65,14 C 16.83,16.33 14.61,18 12,18 C 8.69,18 6,15.31 6,12 C 6,8.69 8.69,6 12,6 C 13.66,6 15.14,6.69 16.22,7.78 L 13,11 L 20,11 L 20,4 Z" />
                    </Canvas>
                  </Viewbox>
                </Button>
                <CheckBox x:Name="ChkEmsTerminalOnly" Content="터미널 창만 보기" IsChecked="True" Checked="ChkEmsTerminalOnly_Changed" Unchecked="ChkEmsTerminalOnly_Changed" Style="{StaticResource ModernCheckBox}" Margin="0,0,10,0" />
                <Button x:Name="BtnEmsRestartTerminal" Content="터미널 재실행" Click="BtnEmsRestartTerminal_Click" Style="{StaticResource BaseBtn}" Height="28" Padding="10,0" />
              </StackPanel>
            </WrapPanel>
          </Border>

          <Border Grid.Row="1" Background="#000000">
            <wv2:WebView2 x:Name="EmsWebView" />
          </Border>
        </Grid>
              </Grid>
            </Grid>

            <!-- TAB 2 ROOT: 상담사 (Person) 관리 -->
            <Grid x:Name="PersonTabRoot" Visibility="Collapsed">
              <views:PersonTabView x:Name="PersonTabControl" />
            </Grid>

            <!-- TAB 3 ROOT: 선번장 · 센터 관리 -->
            <Grid x:Name="DialPlanTabRoot" Visibility="Collapsed">
              <views:DialPlanTabView x:Name="DialPlanTabControl" />
            </Grid>

            <!-- EMPTY STATE WHEN ALL TABS CLOSED -->
            <Grid x:Name="EmptyTabsRoot" Visibility="Collapsed">
              <Border HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="520"
                      Style="{StaticResource CardBorderStyle}"
                      Padding="28,24">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="열려 있는 작업 탭이 없습니다" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                  <TextBlock Text="좌측 사이드바 메뉴 또는 아래 버튼을 눌러 원하는 기능을 탭으로 열 수 있습니다." FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,18" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="내선 · CTI 관리 열기" Click="BtnNavExtCti_Click" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" />
                    <Button Content="Person 관리 열기" Click="BtnNavPerson_Click" Style="{StaticResource BaseBtn}" Margin="0,0,8,0" />
                    <Button Content="선번장 · 센터 열기" Click="BtnNavDialPlan_Click" Style="{StaticResource BaseBtn}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
