<UserControl x:Class="CmOxeProvisioner.Views.UnifiedLookupTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{DynamicResource TextBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- SUB-HEADER BAR -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Border Style="{StaticResource BlockTitleAccentStyle}" />
          <TextBlock Text="통합 조회" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Config 실서버 · 선번장 DB 교차 검색 · 정합성 감사" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,1,0,0" />
        </StackPanel>

        <Border Grid.Column="1"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}"
                BorderThickness="1.5"
                CornerRadius="9"
                Padding="3"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnModeSearch" Content="통합 검색" Click="BtnModeSearch_Click" Style="{StaticResource SegmentedBtnStyle}" FontSize="12.5" Padding="18,6" />
            <Button x:Name="BtnModeAudit" Content="센터 정합성 감사" Click="BtnModeAudit_Click" Style="{StaticResource SegmentedBtnStyle}" FontSize="12.5" Padding="16,6" Margin="3,0,0,0" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button x:Name="BtnExportCsv" Content="CSV 내보내기" Click="BtnExportCsv_Click" Style="{StaticResource BaseBtn}" Height="28" Padding="11,0" FontSize="11.5" Margin="0,0,6,0" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ==================== VIEW 1: UNIFIED CROSS-SEARCH ==================== -->
    <Grid x:Name="SearchModeRoot" Grid.Row="1" Margin="14" Visibility="Visible">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Search Filter Bar -->
      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="165" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="1.25*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="검색어 (번호 / 범위 ~ / 이름 / 사번 / ID / 폴더)" Style="{StaticResource FieldLabelStyle}" />
              <Border Style="{StaticResource SearchBoxFrameStyle}">
                <Grid>
                  <TextBlock Text="예: 31001, 39950~39955, 홍길동, 하이프라자, PTEST..."
                             FontSize="12" Foreground="{DynamicResource MutedBrush}" Opacity="0.6"
                             VerticalAlignment="Center" Margin="10,0,8,0" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=TxtLookupQuery}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBox x:Name="TxtLookupQuery"
                           Background="Transparent" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                           BorderThickness="0" FontSize="12.5" Padding="10,2,8,2" VerticalContentAlignment="Center"
                           KeyDown="TxtLookupQuery_KeyDown" />
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Text="검색 출처" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox x:Name="CmbLookupSource" Style="{StaticResource ModernComboBox}" Height="34" SelectionChanged="FilterCombo_Changed" />
            </StackPanel>

            <StackPanel Grid.Column="4">
              <TextBlock Text="객체 유형" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox x:Name="CmbLookupCategory" Style="{StaticResource ModernComboBox}" Height="34" SelectionChanged="FilterCombo_Changed" />
            </StackPanel>

            <StackPanel Grid.Column="6">
              <TextBlock Text="센터 / 고객사 범위" Style="{StaticResource FieldLabelStyle}" />
              <ComboBox x:Name="CmbLookupCustomer" Style="{StaticResource ModernComboBox}" Height="34" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="FilterCombo_Changed" />
            </StackPanel>

            <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Bottom">
              <CheckBox x:Name="ChkLookupExact" Content="정확히 일치" Style="{StaticResource ModernCheckBox}" Margin="0,0,10,0" VerticalAlignment="Center" />
              <Button x:Name="BtnLookupSearch" Content="통합 조회" Click="BtnLookupSearch_Click" Style="{StaticResource PrimaryBtn}" Height="34" Padding="16,0" Margin="0,0,6,0" />
              <Button x:Name="BtnLookupForceRefresh" Content="↻ 라이브 새로고침" Click="BtnLookupForceRefresh_Click" Style="{StaticResource BaseBtn}" Height="34" Padding="11,0" ToolTip="캐시를 무시하고 Config Server에서 전체 최신 데이터를 다시 읽습니다." />
            </StackPanel>
          </Grid>

          <!-- Busy indicator / Status bar -->
          <DockPanel Grid.Row="1" LastChildFill="False">
            <TextBlock x:Name="TxtLookupStatus" Text="검색어 또는 센터를 선택한 뒤 [통합 조회]를 클릭하세요. (Config 실서버 + 선번장 DB 동시 검색)" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <TextBlock x:Name="TxtLookupElapsed" Text="" FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Right" />
          </DockPanel>
        </Grid>
      </Border>

      <!-- Category Summary Strip -->
      <WrapPanel x:Name="LookupChipsPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8" />

      <!-- Main Results Table + Right Detail Inspector -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="460" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="400" MinWidth="320" MaxWidth="540" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
          <DataGrid x:Name="DgLookupResults"
                    Style="{StaticResource ModernDataGrid}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    SelectionChanged="DgLookupResults_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="출처" Width="78">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource ChipBgBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDialPlanSource}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding SourceDisplay}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource ChipFgBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsDialPlanSource}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OkFgBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="유형" Binding="{Binding category}" Width="106" />
              <DataGridTextColumn Header="키 / 번호" Binding="{Binding key}" Width="125" FontFamily="Consolas" FontWeight="SemiBold" />
              <DataGridTextColumn Header="이름 / 설명" Binding="{Binding name}" Width="160" />
              <DataGridTextColumn Header="센터(추정)" Binding="{Binding customerInferred}" Width="140" />
              <DataGridTextColumn Header="연관 관계" Binding="{Binding relationSummary}" Width="210" />
              <DataGridTemplateColumn Header="진단" Width="105">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAnomaly}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding AnomalySummary}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource OkFgBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasAnomaly}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource WarnFgBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="경로 / 위치" Binding="{Binding folderPath}" Width="280" FontFamily="Consolas" />
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- Right Detail Inspector -->
        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <DockPanel LastChildFill="False" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                  <Border Style="{StaticResource BlockTitleAccentStyle}" />
                  <TextBlock Text="객체 상세 · 교차 매칭" Style="{StaticResource BlockTitleTextStyle}" />
                </StackPanel>
                <Border x:Name="BdDetailBadge" Visibility="Collapsed" CornerRadius="4" Padding="7,2" Background="{DynamicResource ChipBgBrush}" DockPanel.Dock="Right">
                  <TextBlock x:Name="TxtDetailCategoryBadge" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ChipFgBrush}" />
                </Border>
              </DockPanel>

              <TextBlock x:Name="TxtDetailTitle" Text="좌측 표에서 항목을 선택하면 연관 관계와 선번장 매칭 정보가 표시됩니다." FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
              <TextBlock x:Name="TxtDetailPath" Text="" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />

              <Border x:Name="BdDetailAnomaly" Visibility="Collapsed" Background="{DynamicResource WarnBgBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                <TextBlock x:Name="TxtDetailAnomaly" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WarnFgBrush}" TextWrapping="Wrap" />
              </Border>
            </StackPanel>

            <!-- Quick Actions Bottom -->
            <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="BtnDetailCopy" Content="정보 복사" Click="BtnDetailCopy_Click" Style="{StaticResource BaseBtn}" Height="28" Padding="10,0" FontSize="11.5" Margin="0,2,6,2" IsEnabled="False" />
              <Button x:Name="BtnDetailToExtCti" Content="내선·CTI로 보내기 →" Click="BtnDetailToExtCti_Click" Style="{StaticResource PrimaryBtn}" Height="28" Padding="10,0" FontSize="11.5" Margin="0,2,6,2" IsEnabled="False" />
              <Button x:Name="BtnDetailToPerson" Content="Person 관리 →" Click="BtnDetailToPerson_Click" Style="{StaticResource OxeBtn}" Height="28" Padding="10,0" FontSize="11.5" Margin="0,2,0,2" IsEnabled="False" />
            </WrapPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <!-- Linked Relations -->
                <TextBlock Text="연관 객체 (Relations)" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,4" />
                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                  <StackPanel x:Name="DetailRelationsPanel">
                    <TextBlock Text="(선택된 항목 없음)" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                  </StackPanel>
                </Border>

                <!-- DialPlan Cross-Reference -->
                <TextBlock Text="선번장 DB 교차 매칭" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                  <TextBlock x:Name="TxtDetailDialPlanMatch" Text="(항목 선택 시 자동 교차 조회)" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="17" />
                </Border>

                <!-- Raw Attributes -->
                <TextBlock Text="상세 속성 (Attributes)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <DataGrid x:Name="DgDetailAttrs"
                          Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          MaxHeight="260">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="속성" Binding="{Binding Key}" Width="125" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="값" Binding="{Binding Value}" Width="*" FontFamily="Consolas" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ==================== VIEW 2: CENTER INTEGRITY AUDIT ==================== -->
    <Grid x:Name="AuditModeRoot" Grid.Row="1" Margin="14" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
        <DockPanel LastChildFill="False">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
            <TextBlock Text="감사 대상:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="CmbAuditCustomer" Style="{StaticResource ModernComboBox}" Width="260" Height="34" DisplayMemberPath="Label" SelectedValuePath="Value" Margin="0,0,10,0" />
            <Button x:Name="BtnAuditRun" Content="🔍 정합성 감사 실행" Click="BtnAuditRun_Click" Style="{StaticResource PrimaryBtn}" Height="34" Padding="15,0" Margin="0,0,12,0" />
            <CheckBox x:Name="ChkAuditIssuesOnly" Content="이슈 항목만 필터" Checked="ChkAuditIssuesOnly_Changed" Unchecked="ChkAuditIssuesOnly_Changed" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" />
          </StackPanel>

          <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center" DockPanel.Dock="Right">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnAuditSubSummary" Content="센터별 현황" Click="BtnAuditSubSummary_Click" Style="{StaticResource SegmentedBtnStyle}" />
              <Button x:Name="BtnAuditSubPairs" Content="Ext↔Place / CTI↔Person 매핑" Click="BtnAuditSubPairs_Click" Style="{StaticResource SegmentedBtnStyle}" Margin="2,0,0,0" />
              <Button x:Name="BtnAuditSubIssues" Content="탐지 이슈" Click="BtnAuditSubIssues_Click" Style="{StaticResource SegmentedBtnStyle}" Margin="2,0,0,0" />
            </StackPanel>
          </Border>
        </DockPanel>
      </Border>

      <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
        <WrapPanel x:Name="AuditKpiPanel" Orientation="Horizontal" DockPanel.Dock="Left" />
        <TextBlock x:Name="TxtAuditHint" Text="※ '센터별 현황'에서 센터 행을 더블클릭하면 해당 센터의 상세 매핑/이슈를 즉시 조회합니다." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" DockPanel.Dock="Right" />
      </DockPanel>

      <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
        <Grid>
          <!-- Sub-view 1: Center Summary -->
          <DataGrid x:Name="DgAuditSummary"
                    Style="{StaticResource ModernDataGrid}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    MouseDoubleClick="DgAuditSummary_MouseDoubleClick"
                    Visibility="Visible">
            <DataGrid.Columns>
              <DataGridTextColumn Header="센터명" Binding="{Binding customer}" Width="210" FontWeight="SemiBold" />
              <DataGridTextColumn Header="위치" Binding="{Binding floor}" Width="110" />
              <DataGridTextColumn Header="Agent DN" Binding="{Binding agentDnCount}" Width="84" FontFamily="Consolas" />
              <DataGridTextColumn Header="Place" Binding="{Binding placeCount}" Width="74" FontFamily="Consolas" />
              <DataGridTextColumn Header="Login" Binding="{Binding agentLoginCount}" Width="74" FontFamily="Consolas" />
              <DataGridTextColumn Header="ACD Pos" Binding="{Binding acdPosCount}" Width="78" FontFamily="Consolas" />
              <DataGridTextColumn Header="Person" Binding="{Binding personCount}" Width="74" FontFamily="Consolas" />
              <DataGridTextColumn Header="RSI" Binding="{Binding rsiCount}" Width="66" FontFamily="Consolas" />
              <DataGridTextColumn Header="폴더상태" Binding="{Binding FolderHealthText}" Width="80" />
              <DataGridTemplateColumn Header="이슈" Width="76">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasIssues}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding issueCount}" FontFamily="Consolas" FontWeight="Bold" FontSize="11.5">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource OkFgBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource WarnFgBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="비고" Binding="{Binding note}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>

          <!-- Sub-view 2: Pair Rows -->
          <DataGrid x:Name="DgAuditPairs"
                    Style="{StaticResource ModernDataGrid}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    Visibility="Collapsed">
            <DataGrid.Columns>
              <DataGridTextColumn Header="구분" Binding="{Binding kind}" Width="95" FontWeight="SemiBold" />
              <DataGridTextColumn Header="번호" Binding="{Binding number}" Width="95" FontFamily="Consolas" FontWeight="Bold" />
              <DataGridTextColumn Header="1차 존재" Binding="{Binding PrimaryMark}" Width="76" />
              <DataGridTextColumn Header="대응 객체" Binding="{Binding secondaryKey}" Width="115" FontFamily="Consolas" />
              <DataGridTextColumn Header="2차 존재" Binding="{Binding SecondaryMark}" Width="76" />
              <DataGridTextColumn Header="연결 Person / PlaceGroup" Binding="{Binding linkedInfo}" Width="220" />
              <DataGridTemplateColumn Header="상태" Width="78">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIssue}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource WarnBgBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding status}" FontSize="11" FontWeight="Bold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource OkFgBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsIssue}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource WarnFgBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="진단" Binding="{Binding note}" Width="220" />
              <DataGridTextColumn Header="1차 경로" Binding="{Binding primaryPath}" Width="260" FontFamily="Consolas" />
              <DataGridTextColumn Header="2차 경로" Binding="{Binding secondaryPath}" Width="260" FontFamily="Consolas" />
            </DataGrid.Columns>
          </DataGrid>

          <!-- Sub-view 3: Issues -->
          <DataGrid x:Name="DgAuditIssues"
                    Style="{StaticResource ModernDataGrid}"
                    IsReadOnly="True"
                    AutoGenerateColumns="False"
                    Visibility="Collapsed">
            <DataGrid.Columns>
              <DataGridTextColumn Header="심각도" Binding="{Binding severity}" Width="76" FontWeight="Bold" />
              <DataGridTextColumn Header="센터" Binding="{Binding customer}" Width="190" FontWeight="SemiBold" />
              <DataGridTextColumn Header="이슈 코드" Binding="{Binding code}" Width="170" FontFamily="Consolas" />
              <DataGridTextColumn Header="대상" Binding="{Binding target}" Width="130" FontFamily="Consolas" />
              <DataGridTextColumn Header="상세 내용" Binding="{Binding detail}" Width="330" />
              <DataGridTextColumn Header="Config 경로" Binding="{Binding folderPath}" Width="*" FontFamily="Consolas" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
