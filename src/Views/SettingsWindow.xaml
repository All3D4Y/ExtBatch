<Window x:Class="CmOxeProvisioner.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExtBatch 환경 설정 · CM / LightGate 계정 및 기본값"
        Icon="pack://application:,,,/ExtBatch;component/icon.ico"
        Width="560" Height="745"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextBrush}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="36"
                  ResizeBorderThickness="0"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False"
                  CornerRadius="0" />
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource AppBgBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Custom Themed Title Bar -->
      <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="False">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" DockPanel.Dock="Left">
            <Image Source="pack://application:,,,/ExtBatch;component/icon.ico" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="ExtBatch 환경 설정 · CM / LightGate 계정 및 기본값" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <Button Click="BtnCancel_Click" Style="{StaticResource CaptionCloseBtn}" DockPanel.Dock="Right" HorizontalAlignment="Right" ToolTip="닫기">
            <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
          </Button>
        </DockPanel>
      </Border>

      <!-- Main Body -->
      <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="CM·EMS 접속 계정과 비밀번호는 현재 Windows 사용자 계정 전용(DPAPI)으로 암호화 저장됩니다."
                   FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

        <!-- Scrollable Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
          <StackPanel Margin="0,0,0,4">
            <!-- Section 1: CM Settings -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Genesys Configuration Manager (CM)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />

                <TextBlock Text="CM 실행 파일 (sce.exe 경로)" Style="{StaticResource FieldLabelStyle}" />
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="TxtCmExePath" Grid.Column="0" Style="{StaticResource ModernTextBox}" FontFamily="Consolas" />
                  <Button Grid.Column="1" Content="찾아보기" Click="BtnBrowseCm_Click" Style="{StaticResource BaseBtn}" Margin="8,0,0,0" />
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="CM 아이디 (비워두면 기존 입력값 유지)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TxtCmUserId" Style="{StaticResource ModernTextBox}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="CM 비밀번호" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox x:Name="PwdCmPassword" Style="{StaticResource ModernPasswordBox}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Section 2: EMS Settings -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Alcatel OXE · EMS (LightGate 웹 터미널)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="EMS 터미널 URL" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TxtEmsUrl" Style="{StaticResource ModernTextBox}" FontFamily="Consolas" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="자동 선택 서버명" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TxtEmsServerKeyword" Style="{StaticResource ModernTextBox}" />
                  </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="EMS 로그인 아이디 (이메일)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TxtEmsUserId" Style="{StaticResource ModernTextBox}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="EMS 비밀번호" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox x:Name="PwdEmsPassword" Style="{StaticResource ModernPasswordBox}" />
                  </StackPanel>
                </Grid>

                <CheckBox x:Name="ChkEmsAutoLogin" Content="EMS 로그인 화면 열릴 때 저장된 ID / PW 자동 입력" Style="{StaticResource ModernCheckBox}" Margin="0,2,0,8" />
                <CheckBox x:Name="ChkEmsTerminalOnly" Content="서버 터미널 연결 시 사이드바를 숨기고 터미널 창만 표시" Style="{StaticResource ModernCheckBox}" />
              </StackPanel>
            </Border>

            <!-- Section 3: OXE & Behavior Defaults -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="OXE 스크립트 기본값 및 경고/테마" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="OXE Node 번호" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TxtNodeNumber" Style="{StaticResource ModernTextBox}" FontFamily="Consolas" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="기본 내선 Profile" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TxtDefProfExt" Style="{StaticResource ModernTextBox}" FontFamily="Consolas" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="기본 Login Profile" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TxtDefProfLogin" Style="{StaticResource ModernTextBox}" FontFamily="Consolas" />
                  </StackPanel>
                  <StackPanel Grid.Column="6">
                    <TextBlock Text="내선 경고 기준(개)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TxtWarnThreshold" Style="{StaticResource ModernTextBox}" FontFamily="Consolas" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="UI 테마 (안티그래비티 기준 · 선택 시 미리보기)" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox x:Name="CmbTheme" Style="{StaticResource ModernComboBox}" SelectionChanged="CmbTheme_SelectionChanged" Margin="0,0,0,10" />

                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                  <TextBlock x:Name="TxtDialPlanBlurValue"
                             DockPanel.Dock="Right"
                             Text="55%"
                             FontSize="12"
                             FontWeight="Bold"
                             FontFamily="Consolas"
                             Foreground="{DynamicResource PrimaryBrush}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="선번장 행 펼치기 배경 블러 강도 (0% ~ 100%)"
                             Style="{StaticResource FieldLabelStyle}"
                             Margin="0" />
                </DockPanel>
                <Slider x:Name="SldDialPlanBlur"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        SmallChange="5"
                        LargeChange="10"
                        ValueChanged="SldDialPlanBlur_ValueChanged"
                        Margin="0,0,0,8" />

                <TextBlock x:Name="TxtStoragePath" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Bottom Buttons -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
          <Button Content="기본값 복원" Click="BtnReset_Click" Style="{StaticResource BaseBtn}" DockPanel.Dock="Left" />
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="취소" Click="BtnCancel_Click" Style="{StaticResource BaseBtn}" MinWidth="76" Margin="0,0,8,0" />
            <Button Content="저장" Click="BtnSave_Click" Style="{StaticResource PrimaryBtn}" MinWidth="86" />
          </StackPanel>
        </DockPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
